# Backend Configuration
# Base URL of the FastAPI backend.
BACKEND_URL=http://localhost:8000

# API Paths
# Path for the chat endpoint on the backend.
BACKEND_CHAT_PATH=/api/chat

# Path for the title generation endpoint on the backend.
BACKEND_TITLE_PATH=/api/title

# Frontend Configuration
# Base URL for frontend API calls.
NEXT_PUBLIC_FRONTEND_API_BASE=/api
